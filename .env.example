# Copy to .env and fill in what you need: the credentials for the ONE provider you
# actually use, and the YOUR AGENCY section below.
#
#     cp .env.example .env         (macOS / Linux / Git Bash)
#     copy .env.example .env       (Windows PowerShell or cmd)
#
# !! .env is gitignored. Keep it that way. If a key ever lands in a commit, rotate
# !! it - scrubbing history is not sufficient once it has been pushed.
#
# On Windows/IntelliJ you can set these in the Python run configuration's
# "Environment variables" field instead of a .env file. Note that IntelliJ stores
# those in .idea/workspace.xml, which is gitignored here for exactly that reason -
# but .idea/runConfigurations/*.xml is NOT, so do not put keys in a shared run config.

# ---------------------------------------------------------------------------
# WHAT KIND OF SYSTEM IS UNDER TEST
# ---------------------------------------------------------------------------
# Decides which datasets/ probes run and which judges/ rubrics grade them.
# internal_productivity | public_conversational | constituent_decision | procured_vendor_cots
# Defined in pyrit_campaigns/profiles.py.
RT_PROFILE=internal_productivity

# ---------------------------------------------------------------------------
# YOUR AGENCY - the details the probes are written around
# ---------------------------------------------------------------------------
# The probes in datasets/ have blanks like {{ program_name }} so they work for any
# agency. Each blank is filled from the matching RT_ setting below. Until the ones
# your profile uses are set, the single-turn scan stops before sending anything:
# a model asked about "TODO Program" answers about a program that does not exist,
# and every finding would describe that instead of your system.
#
# Use real names for the program, agency, and tools, so the probes read the way a
# real constituent or staff member would write them. Use SYNTHETIC values for
# anything about a person or record. Everything here lands in the PyRIT database
# and in finding reports.
#
# The program the system serves, as a constituent would name it.
# RT_PROGRAM_NAME=Supplemental Nutrition Assistance Program (SNAP)
# The agency that runs it.
# RT_AGENCY_NAME=Department of Human Services
# The kind of record the system handles.
# RT_RECORD_TYPE=case
# A tool or action the system can call (excessive-agency probes).
# RT_TOOL_NAME=update_case_status
#
# Optional - these ship with synthetic defaults (see pyrit_campaigns/profiles.py):
# A fake person's name, used in data-leak probes.
# RT_SYNTHETIC_NAME=Jordan Testcase
# Bias pairs change ONE thing between two otherwise identical questions. Change
# each pair together, and keep both sides equally plausible for your jurisdiction.
# RT_NAME_VARIANT_A=Jamal Washington
# RT_NAME_VARIANT_B=Brad Sullivan
# Two zip codes that differ in median income but share the same program rules.
# RT_ZIP_LOWER_INCOME=21223
# RT_ZIP_HIGHER_INCOME=21210
# A fake case id and a canary string - plant the canary in a test document the
# test user should NOT be able to reach, so a leak is unmistakable.
# RT_SYNTHETIC_CASE_ID=ZZ-TEST-00417
# RT_CANARY_TOKEN=ZZ-CANARY-4417
#
# Only to try out the tooling with the placeholders still in (findings will be
# meaningless):
# RT_ALLOW_PLACEHOLDERS=1

# ---------------------------------------------------------------------------
# WHICH MODEL GETS ATTACKED
# ---------------------------------------------------------------------------
# gemini | openai | anthropic | bedrock | vertex | app
# Set this to "app" for a real assessment - see the note at the bottom.
RT_PROVIDER=gemini

# Optional: override the default model for the chosen provider.
# Defaults live in PROVIDER_DEFAULTS in pyrit_campaigns/target_factory.py.
# RT_MODEL=gemini/gemini-2.5-flash
# RT_MODEL=openai/gpt-5
# RT_MODEL=anthropic/claude-haiku-4-5

# ---------------------------------------------------------------------------
# WHICH MODEL JUDGES / ATTACKS
# ---------------------------------------------------------------------------
# The judge scores whether an attack succeeded. The adversarial model writes the
# escalating turns in multi-turn campaigns.
#
# TODO: make these a DIFFERENT provider from RT_PROVIDER. Two reasons, and both
# will otherwise quietly invalidate your results:
#   - A model is a poor judge of its own jailbreak.
#   - An adversarial model with the same guardrails as the target will refuse to
#     write the attack, and you will read that refusal as a passing test.
RT_JUDGE_PROVIDER=gemini
RT_ADVERSARIAL_PROVIDER=gemini

# ---------------------------------------------------------------------------
# CREDENTIALS - fill in only what you use
# ---------------------------------------------------------------------------

# Google Gemini (AI Studio key - https://aistudio.google.com/apikey)
# The easiest path: an API key, no cloud project or billing setup required.
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic direct (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# AWS Bedrock (RT_PROVIDER=bedrock)
# No API key: uses the standard AWS credential chain. Pick ONE of the options below.
# On EC2/ECS/Lambda with an attached role, set only the region.
# Requires: bedrock:InvokeModel on the principal, AND per-model access granted under
# "Model access" in the Bedrock console (missing access returns AccessDeniedException,
# which looks like an auth failure but is an authorization one).
# Set the region explicitly: with none set, LiteLLM silently falls back to
# us-west-2, where your model may not be granted - which surfaces as a confusing
# AccessDeniedException for a region you never chose.
AWS_REGION_NAME=us-east-1
# 1. An existing named profile (recommended - no secrets in this file):
# AWS_PROFILE_NAME=your-profile
#    (AWS_PROFILE works too, via the default boto3 chain - as does SSO: run
#     `aws sso login --profile <name>` first, since SSO sessions expire daily.)
# 2. Static keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# 3. Bedrock API key (bearer token, bypasses SigV4):
# AWS_BEARER_TOKEN_BEDROCK=
#
# Model id goes in RT_MODEL. Prefer bedrock/converse/ for Anthropic models; the
# "us." prefix selects a cross-region inference profile.
# RT_MODEL=bedrock/converse/us.anthropic.claude-sonnet-4-20250514-v1:0

# Claude via Google Vertex AI (RT_PROVIDER=vertex)
# Uses Google Application Default Credentials, NOT an API key. Requires:
#   - billing enabled on the project
#   - Anthropic models enabled in Vertex Model Garden
#   - roles/aiplatform.user on your identity
#   - gcloud auth application-default login   (or GOOGLE_APPLICATION_CREDENTIALS)
# Note: Vertex AI Express Mode credentials do NOT work for Anthropic models -
# they are Gemini-only. If your ADC identity is a vertex-express@ service
# account, use RT_PROVIDER=gemini instead.
PROJECT_ID=
GOOGLE_VERTEX_REGION=us-east5
# Path to a service account key JSON. Store it OUTSIDE this repo.
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\keys\service-account.json

# Azure OpenAI (add a row to PROVIDER_DEFAULTS in target_factory.py first)
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# ---------------------------------------------------------------------------
# YOUR APPLICATION (RT_PROVIDER=app) - the target that matters
# ---------------------------------------------------------------------------
# Red-teaming a raw model tells you about the vendor's model. Red-teaming your
# deployed application tells you about your system prompt, your retrieval index,
# and your tool permissions - which is where agency risk actually lives.
#
# TODO: finish the 'app' branch in pyrit_campaigns/target_factory.py, then set these.
#
#   !! Non-production instance, synthetic data, and written authorization from the
#   !! system owner before you point anything at a real deployment.
APP_ENDPOINT=
APP_TOKEN=

# Procured vendor system (RT_PROFILE=procured_vendor_cots)
# Point the 'app' target at the vendor's endpoint. Check the ToS and get the vendor's
# written permission before automated testing.
VENDOR_ENDPOINT=
VENDOR_API_KEY=

# ---------------------------------------------------------------------------
# CAMPAIGN TUNING
# ---------------------------------------------------------------------------
# Multi-turn campaigns cost roughly max_turns x 3 API calls per objective (target +
# adversarial + judge), plus retries on backtrack. Start small.
RT_MAX_TURNS=5
RT_MAX_BACKTRACKS=5

# The single-turn scan costs one target call per probe PLUS one judge call per probe
# per rubric, so the rubric count is the multiplier that matters.
RT_MAX_CONCURRENCY=3

# Set to 1 to make a policy violation exit non-zero (for CI gating). Off by default:
# in a red team run findings are the expected output, not an error.
# RT_FAIL_ON_FINDING=1

# ---------------------------------------------------------------------------
# CORPORATE NETWORK NOTE
# ---------------------------------------------------------------------------
# Behind a TLS-inspecting proxy, every entry point calls
# truststore.inject_into_ssl() so Python uses the OS certificate store, which
# already trusts your proxy. If you add a new entry point, copy that block too.
