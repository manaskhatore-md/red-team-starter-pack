# Copy to .env and fill in the lines you need; leave the rest blank. .env is
# gitignored. If a key ever ends up in a commit, rotate it.
# Every other setting is in the README.
# No .env? Every line here also works as an environment variable, and a variable already
# set beats the file. RT_ENV_FILE (an environment variable, not a line here) names another
# file, or is none to read environment variables only.

# --- WHAT TO TEST -------------------------------------------------------------
# Profile: internal_productivity, public_conversational, constituent_decision.
# Blank runs the built-in default: every suite, the core probes.
RT_PROFILE=
# Optional probe selection for single_turn_scan, replacing the profile's own (blank runs the profile's):
# all, general, core, bias, bias-core, bias-templated, m-n ranges, probe names, or a pack's name
RT_PROBES=
# Optional folders of your own probes, comma-separated, e.g. overlays/my-agency. Each file is
# named after the suite it adds to. A file in its fixtures/ named like a shipped one adds
# entries for the kit's templates: facts.yaml your hallucination facts, scenarios.yaml your
# bias pairs, actions.yaml your excessive_agency actions (copy overlays/example/).
# core leaves them out: send them with RT_PROBES=core,my-agency
RT_EXTRA_SUITES=
# Optional: a real fact confirmed more than this many days ago is listed to re-check (default 365)
RT_FACT_MAX_AGE_DAYS=
# Optional encoding(s) for probes and multi-turn turns, each also sent plain as a control (use + to chain, or --no-control / RT_CONTROL=0 to skip control): base64, rot13, leetspeak, unicode-confusable, zero-width, char-space, pii-space, pii-space-nodash, pii-nodash, url, all
RT_CONVERTERS=
# Provider: gemini, openai, anthropic, bedrock, vertex, or app (your deployed chatbot)
RT_PROVIDER=gemini
# Blank uses the provider's default model.
RT_MODEL=

# --- YOUR APPLICATION (RT_PROVIDER=app only) ----------------------------------
# Non-production instance, synthetic data, and written authorization first.
APP_ENDPOINT=
# The request body, with {PROMPT} where the probe goes. Blank: {"message": "{PROMPT}"}
APP_REQUEST_TEMPLATE=
# Where the reply is in the response, e.g. answer or choices.0.message.content
APP_RESPONSE_PATH=
# For SSE or NDJSON streams: concat (default, joins the pieces) or last (takes the final event's text)
APP_STREAM_MODE=
# Optional: where tool calls or retrieved sources are, e.g. trace.rounds or citations
APP_TRACE_PATH=
# Optional: where guardrail or routing control fields are, e.g. blocked,guardrail
APP_CONTROL_PATH=
# no if the app has no documents to search (no retrieval). Blank assumes it may have some,
# so with no APP_TRACE_PATH a flag on a specific (form number, deadline) is unverified.
APP_RETRIEVAL=
# Sent as the x-api-key header.
APP_API_KEY=
# Sent as Authorization: Bearer <token>.
APP_TOKEN=
# Or, for a token that expires: a command that prints a fresh one (run at start and on 401;
# cmd.exe on Windows; http transport only). No passwords here: see README, streaming section.
APP_TOKEN_COMMAND=

# --- JUDGE --------------------------------------------------------------------
# Grades the replies. Blank uses RT_PROVIDER, but a different provider is better.
RT_JUDGE_PROVIDER=
RT_JUDGE_MODEL=

# --- ATTACKER (adaptive and crescendo) ----------------------------------------
# Writes the attacks in multi-turn campaigns. Blank uses the judge's provider.
# A model that won't refuse security work suits it, e.g. Gemini on Vertex (see Vertex below):
# RT_ADVERSARIAL_PROVIDER=vertex
# RT_ADVERSARIAL_MODEL=vertex_ai/gemini-4-argon-cyber-permissive   (or vertex_ai/gemini-3.8-flash-cyber)
RT_ADVERSARIAL_PROVIDER=
RT_ADVERSARIAL_MODEL=

# --- CREDENTIALS (only for the providers you use) -----------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bedrock uses your AWS login, not a key. See "Running on Bedrock" in the README.
AWS_REGION_NAME=us-east-1
# Blank uses your default AWS profile.
AWS_PROFILE_NAME=

# Vertex uses your Google login (gcloud auth application-default login), not a key.
# Uncomment what you need: the project, Claude's region (default us-east5), Gemini's (default global).
# PROJECT_ID=your-gcp-project
# GOOGLE_VERTEX_REGION=us-east5
# GOOGLE_VERTEX_GEMINI_REGION=global

# --- YOUR AGENCY --------------------------------------------------------------
# Fills the blanks in the probes. The scan prints any others it needs.
RT_AGENCY_NAME=
RT_PROGRAM_NAME=

# --- WHAT NOT TO SCRUB --------------------------------------------------------
# public contact details to keep visible in reports, comma-separated
RT_SCRUB_ALLOW=