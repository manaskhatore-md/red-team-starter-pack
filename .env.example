# Copy to .env (cp, or copy on Windows) and fill in what you use. Lines starting
# with # are optional. Keep comments on their own line after an empty value
# (KEY=  # note), or the note becomes the value.
# .env is gitignored. A key that ever lands in a commit needs rotating, not scrubbing.

# =============================================================================
# 1. WHAT TO TEST
# =============================================================================
# internal_productivity | public_conversational | constituent_decision | procured_vendor_cots
RT_PROFILE=internal_productivity

# gemini | openai | anthropic | bedrock | vertex | app (your deployed application)
RT_PROVIDER=gemini
# RT_MODEL=openai/gpt-5                          # each provider has a default

# Default: the profile's stand-in (system_prompts/), or none for RT_PROVIDER=app.
# RT_SYSTEM_PROMPT_FILE=C:/secure/our_chatbot_prompt.txt    # or: none

# =============================================================================
# 2. YOUR APPLICATION (RT_PROVIDER=app)
# =============================================================================
# !! Non-production instance, synthetic data, and written authorization first.
# Single-turn only: run single_turn_scan, not multi_turn_crescendo.
APP_ENDPOINT=
# APP_REQUEST_TEMPLATE={"query": "{PROMPT}"}     # default {"message": "{PROMPT}"}
# APP_RESPONSE_PATH=answer                       # dotted, e.g. choices.0.message.content
# Sent as the x-api-key header, or as Authorization: Bearer:
# APP_API_KEY=
# APP_TOKEN=

# =============================================================================
# 3. JUDGE AND ATTACKER
# =============================================================================
# Use a different provider from RT_PROVIDER, and pin the judge model - a judge
# that changes between runs changes the finding rate. Unset, the judge follows
# RT_PROVIDER and the attacker follows the judge.
# RT_JUDGE_PROVIDER=bedrock
# RT_JUDGE_MODEL=bedrock/converse/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# RT_ADVERSARIAL_PROVIDER=bedrock                # multi-turn campaigns only
# RT_ADVERSARIAL_MODEL=

# =============================================================================
# 4. CREDENTIALS - only for the providers you use
# =============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bedrock: any standard AWS credential source (CLI login, SSO profile, attached
# role). Grant the model under "Model access" in the Bedrock console first.
AWS_REGION_NAME=us-east-1
# AWS_PROFILE_NAME=your-profile                  # aws sso login --profile your-profile first
# AWS keys in this file outrank your profile, so leave them out or set them all:
# AWS_ACCESS_KEY_ID=, AWS_SECRET_ACCESS_KEY=, and AWS_SESSION_TOKEN= for ASIA... keys.

# Vertex has a known limitation - see the README before using it.
# PROJECT_ID=

# =============================================================================
# 5. YOUR AGENCY - fills the {{ blanks }} in the probes
# =============================================================================
# Unset, probes ask about "TODO Program". Use real names here; anything about a
# person stays synthetic. Test data (bias-pair names and zips, synthetic records)
# is shared test design, so it lives in pyrit_campaigns/profiles.py.
# RT_PROGRAM_NAME=Supplemental Nutrition Assistance Program (SNAP)
# RT_AGENCY_NAME=Department of Human Services
# RT_CONTACT_CHANNEL=1-800-555-0100 or https://example.gov/help
# RT_RECORD_TYPE=case
# RT_TOOL_NAME=update_case_status

# =============================================================================
# 6. RUN SETTINGS
# =============================================================================
# RT_REPEATS=1                 # send each probe N times, to get failure rates
# RT_MAX_CONCURRENCY=3         # probes in flight at once; set 1 if throttled
# RT_MAX_TURNS=5               # multi-turn campaigns only
