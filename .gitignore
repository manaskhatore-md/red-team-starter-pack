__pycache__/
*.py[cod]
.venv/
venv/

# Credentials - never commit
.env
*.env
service-account*.json
*-key.json
gcloud-key*.json

# IDE settings are per-person. IntelliJ run configs also store env vars (including
# API keys) in .idea/workspace.xml.
.idea/

# Test output. These contain full prompts and responses from every run, so they
# inherit the data classification of whatever you tested against. Review before
# sharing any of it, even internally.
findings/
scan-output.txt
# PyRIT's SQLITE memory database. By default it lives outside the repo, in PyRIT's
# own data folder (%LOCALAPPDATA%\pyrit\dbdata on Windows, ~/.local/share/dbdata on
# Linux), but it lands here if you override the path
dbdata/
*.db

# Grounding eval set - may contain real constituent questions pulled from logs
data_fixtures/grounding_eval_set.json

# pytest
.pytest_cache/
